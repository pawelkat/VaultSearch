# ~/.config/vault-events/config.env — read by contrib/vault-search-watchdog.
# Event sync is OFF unless VAULT_EVENTS_ENABLE=1.
VAULT_EVENTS_ENABLE=0
VAULT_EVENTS_DEVICE=box
# Run the hub on this host (1) or only the agent (0).
VAULT_EVENTS_HUB=1
VAULT_EVENTS_LISTEN=tcp/0.0.0.0:7447
VAULT_EVENTS_CONNECT=tcp/127.0.0.1:7447
# One-way Drive backup from the hub (vault-rclone backup = rclone copy --update).
VAULT_EVENTS_BACKUP=0
VAULT_EVENTS_BACKUP_DRY_RUN=1
# 1 = start vault-searchd without --sync-interval (stop two-way bisync).
VAULT_EVENTS_DISABLE_BISYNC=0
