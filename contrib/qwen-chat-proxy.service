# Injects System/Nitro5 Qwen.md plus the Zurich date, then forwards to llama-server.
# Not installed by the build. Copy to ~/.config/systemd/user/ and enable there.
# Point Tailscale Serve at 127.0.0.1:8082. Leave llama-server on 8080.
[Unit]
Description=Nitro5 Qwen chat proxy
After=llama-server.service
Wants=llama-server.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/projects/VaultSearch/contrib/chat_proxy.py
Environment="VAULT_NOTE=%h/Obsidian/Vault/System/Nitro5 Qwen.md"
Environment=VAULT_ROOT=%h/Obsidian/Vault
Environment=PUBLIC_BASE=https://nitro5.tailf52603.ts.net
Environment=UPSTREAM=http://127.0.0.1:8080
Environment=BIND=127.0.0.1
Environment=PORT=8082
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
