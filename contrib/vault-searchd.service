[Unit]
Description=Vault search index
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/vault-searchd serve --vault %h/Obsidian/Vault --index %h/.local/share/vault-search/index.db --embed-url http://127.0.0.1:8081/v1/embeddings --dim 768
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
